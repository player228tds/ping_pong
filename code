import pygame
import time
import random

class GameSprite():
    def __init__(self, x, y, width, height, color = None):
        self.rect = pygame.Rect(x, y, width, height)
        self.color = color
        self.rect.x = x
        self.rect.y = y
        self.height = height

    def draw(self, surface):
        pygame.draw.rect(surface, self.color, self.rect)
    
    def collidepoint(self, x, y):
        return self.rect.collidepoint(x,y)

    def colliderect(self, rect):
        return self.rect.colliderect(rect)

class Player(GameSprite):
    def __init__(self, x, y, width, height, movement, color = None):
        super().__init__(x, y, width, height, color = None)
        self.rect = pygame.Rect(x, y, width, height)
        self.color = color
        self.rect.x = x
        self.rect.y = y
        self.height = height
        self.width = width
        self.speed = 5
        self.movement = movement
        
    def update_mouse(self):
        if not (mouse_pos[1] >= (height_ds - (self.height / 2))) and not (mouse_pos[1] <= (self.height / 2)):
            self.rect.y = mouse_pos[1] - (self.height / 2)
        elif mouse_pos[1] >= (height_ds - (self.height / 2)):
            self.rect.y = height_ds - self.height
        elif mouse_pos[1] <= (self.height / 2):
            self.rect.y = 0
    
    def update_keyboardws1(self):
        Keys_pressed = pygame.key.get_pressed()
        if Keys_pressed[pygame.K_w] and not (self.rect.y == 0) :
            self.rect.y -= self.speed
        if Keys_pressed[pygame.K_s] and not (self.rect.y == height_ds - self.height):
            self.rect.y += self.speed
    
    def update_keyboardws2(self):
        Keys_pressed = pygame.key.get_pressed()
        if Keys_pressed[pygame.K_UP] and not (self.rect.y == 0) :
            self.rect.y -= self.speed
        if Keys_pressed[pygame.K_DOWN] and not (self.rect.y == height_ds - self.height):
            self.rect.y += self.speed
        
    def bot_play(self, ball_rect):
        needed_pos = 0
        if not (ball_rect.rect.y >= (height_ds - (self.height / 2))) and not (ball_rect.rect.y <= (self.height / 2)):
            needed_pos = ball_rect.rect.y - (self.height / 2)
        elif ball_rect.rect.y >= (height_ds - (self.height / 2)):
            needed_pos = height_ds - self.height
        elif ball_rect.rect.y <= (self.height / 2):
            needed_pos = 0
        
        if ball_rect.rect.x >= widht_ds / 2 and ball_rect.dx > 0:
            if self.rect.y > needed_pos:
                self.rect.y -= self.speed
            if self.rect.y < needed_pos:
                self.rect.y += self.speed
        
        if ball_rect.rect.x <= widht_ds / 2:
            if self.rect.y > needed_pos:
                self.rect.y -= self.speed / 4
            if self.rect.y < needed_pos:
                self.rect.y += self.speed / 2
    
    def move(self, ball):
        if self.movement == 'key1':
            self.update_keyboardws1()
        if self.movement == 'key2':
            self.update_keyboardws2()
        if self.movement == 'bot':
            self.bot_play(ball)
        if self.movement == 'mouse':
            self.update_mouse()    
            
    

class Ball(GameSprite):
    def __init__(self, x, y, width, height, speed, color = None):
        super().__init__(x, y, width, height, color = None)
        self.rect = pygame.Rect(x, y, width, height)
        self.color = color
        self.rect.x = x
        self.rect.y = y
        self.height = height
        self.width = width
        self.dx = speed
        self.dy = speed
        self.no_lose = False
        self.start = True
        self.select_pl = player1
        self.time = 0
    
    def move(self, listt):
        rect1 = listt[0]
        rect2 = listt[1]
        self.rect.x += self.dx
        self.rect.y += self.dy
        
        if self.rect.y >= height_ds:
            self.dy *= -1

        if self.rect.y <= 0:
            self.dy *= -1

        if self.no_lose and self.rect.x >= widht_ds:
            self.dx *= -1

        if self.no_lose and self.rect.x <= 0:
            self.dx *= -1
        
        if self.colliderect(rect1.rect):
            if self.rect.x + self.width / 2 < rect1.rect.x + rect1.width:
                if self.rect.y + self.height > rect1.rect.y:
                    self.dy *= -1
                if self.rect.y + self.height < rect1.rect.y:
                    self.dy *= -1
            else:
                self.dx *= -1
        
        if self.colliderect(rect2.rect):
            if self.rect.x + self.width / 2 > rect2.rect.x:
                if self.rect.y + self.height > rect2.rect.y:
                    self.dy *= -1
                if self.rect.y + self.height < rect2.rect.y:
                    self.dy *= -1
            else:
                self.dx *= -1

    
    def set_no_lose(self):
        self.no_lose = True

    def update(self, players):
        Keys_pressed = pygame.key.get_pressed()
        mouse_buttons = pygame.mouse.get_pressed()
        players[0] = player1
        players[1] = player2

        if self.rect.x > widht_ds + 50:
            self.select_pl = player2
            self.start = True
            self.time = current_time
        if self.rect.x < 0 - 50:
            self.select_pl = player1
            self.start = True
            self.time = current_time

        if self.start:
            if self.select_pl == player1:
                self.rect.x = player1.rect.x + 30
                self.rect.y = player1.rect.y + player1.height / 2
                self.set_right()
                if (Keys_pressed[pygame.K_d] and player1.movement == 'key1') or (Keys_pressed[pygame.K_RIGHT] and player1.movement == 'key2') or (mouse_buttons[0] and player1.movement == 'mouse'):
                    self.start = False
                    self.set_up()
                    if random.randint(1, 2) == 1:
                        self.dy *= -1
                if player1.movement == 'bot' and (current_time - self.time > 2000):
                    self.start = False
                    self.set_up()
                    if random.randint(1, 2) == 1:
                        self.dy *= -1
            
            if self.select_pl == player2:
                self.rect.x = player2.rect.x - 30
                self.rect.y = player2.rect.y + player1.height / 2
                self.set_left()
                print(current_time - self.time)
                if (Keys_pressed[pygame.K_a] and player2.movement == 'key1') or (Keys_pressed[pygame.K_LEFT] and player2.movement == 'key2') or (mouse_buttons[0] and player2.movement == 'mouse'):
                    self.start = False
                    self.set_up()
                    if random.randint(1, 2) == 1:
                        self.dy *= -1
                if player2.movement == 'bot' and (current_time - self.time > 2000):
                    self.start = False
                    self.set_up()
                    if random.randint(1, 2) == 1:
                        self.dy *= -1

        if self.start == False:
            self.move(players)
            
    
    def set_up(self):
        if self.dy < 0:
            self.dy *= -1
    
    def set_down(self):
        if self.dy > 0:
            self.dy *= -1
    
    def set_left(self):
        if self.dx > 0:
            self.dx *= -1

    def set_right(self):
        if self.dx < 0:
            self.dx *= -1
        



